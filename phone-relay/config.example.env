# Copy this file to config.env (on the phone only) and fill it in:
#   cp config.example.env config.env && nano config.env
# config.env is never uploaded to GitHub (.gitignore keeps it out).

# From @BotFather. Keep it secret — anyone with it controls the bot.
BOT_TOKEN=

# My own Telegram chat id: messages go here, and only my replies count.
CHAT_ID=8870072584

# Optional: an Anthropic API key (console.anthropic.com) lets Da Niu
# answer visitors while I'm busy. Leave empty to turn that off.
# After adding it, run `npm install` once in this folder.
ANTHROPIC_API_KEY=
# At most this many AI answers a day (keeps the bill small).
AI_DAILY_LIMIT=200

# Optional: a fixed address from a named Cloudflare Tunnel (needs my
# own domain — see README). Leave both empty to get a free temporary
# *.trycloudflare.com address that changes whenever the phone restarts.
TUNNEL_TOKEN=
PUBLIC_URL=

# Websites allowed to talk to the phone (comma separated).
ALLOWED_ORIGINS=https://elainewangyy.github.io,http://localhost:8000,http://127.0.0.1:8000
PORT=8787
